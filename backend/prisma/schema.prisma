generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  telegramId         String    @unique
  createdAt          DateTime  @default(now())
  recapFrequencyDays Int       @default(7)
  lastWorkoutRecapAt DateTime?

  meals           Meal[]
  goals           Goal[]
  devices         Device[]
  emailAccounts   EmailAccount[]
  calendarEvents  CalendarEvent[]
  workoutSessions WorkoutSession[]
}

model Meal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  description String
  grams       Float?
  photoPath   String?
  calories    Float?
  loggedAt    DateTime @default(now())
}

model Device {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  user       User    @relation(fields: [userId], references: [id])
  userId     String  @db.ObjectId
  name       String
  provider   String // "shelly" | "tahoma"
  externalId String
  deviceType String
  lastState  String?
}

model Goal {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])
  userId      String       @db.ObjectId
  title       String
  description String?
  category    String       @default("general") // "general" | "gym"
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  actions     GoalAction[]
}

model GoalAction {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  goal        Goal      @relation(fields: [goalId], references: [id])
  goalId      String    @db.ObjectId
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
}

model EmailAccount {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  user     User    @relation(fields: [userId], references: [id])
  userId   String  @db.ObjectId
  provider String
  address  String
  authRef  String?
}

model CalendarEvent {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  user           User      @relation(fields: [userId], references: [id])
  userId         String    @db.ObjectId
  provider       String
  externalId     String
  title          String
  startsAt       DateTime
  important      Boolean   @default(false)
  reminderSentAt DateTime?
}

model WorkoutSession {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  user      User              @relation(fields: [userId], references: [id])
  userId    String            @db.ObjectId
  loggedAt  DateTime          @default(now())
  exercises WorkoutExercise[]
}

type WorkoutExercise {
  name     String
  sets     Int?
  reps     Int?
  weightKg Float?
  notes    String?
}
