generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Team {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  inviteCode         String    @unique
  createdAt          DateTime  @default(now())
  recapFrequencyDays Int       @default(7)
  lastWorkoutRecapAt DateTime?

  members           User[]
  meals             Meal[]
  goals             Goal[]
  devices           Device[]
  calendarEvents    CalendarEvent[]
  workoutSessions   WorkoutSession[]
  shoppingListItems ShoppingListItem[]
}

model User {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  // Identita' Keycloak (login web email/password/social). Assente finche' l'utente
  // usa solo il bot Telegram senza aver mai collegato un account web.
  keycloakId                String?   @unique
  email                     String?
  displayName               String?
  // Identita' Telegram. Assente finche' non si collega il bot con /collega.
  telegramId                String?   @unique
  team                      Team      @relation(fields: [teamId], references: [id])
  teamId                    String    @db.ObjectId
  createdAt                 DateTime  @default(now())
  // Codice temporaneo mostrato in dashboard per collegare il bot Telegram
  // allo stesso account/team via il comando /collega <code>.
  telegramLinkCode          String?   @unique
  telegramLinkCodeExpiresAt DateTime?

  meals           Meal[]
  goals           Goal[]
  emailAccounts   EmailAccount[]
  calendarEvents  CalendarEvent[]
  workoutSessions WorkoutSession[]
  holdings        Holding[]
  googleAccount   GoogleAccount?
  diaryEntries    DiaryEntry[]
  socialAccounts  SocialAccount[]
  socialPosts     SocialPost[]
  conversations   Conversation[]
  trainingPlans   TrainingPlan[]
  nutritionPlans  NutritionPlan[]
}

/**
 * Pagina Facebook o account Instagram Business collegato tramite un'unica
 * app Meta (Graph API): entrambi passano dallo stesso OAuth "Facebook Login".
 * Personale (non condiviso col team): ognuno collega i propri account.
 */
model SocialAccount {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])
  userId      String       @db.ObjectId
  provider    String // "facebook_page" | "instagram"
  externalId  String // page id o instagram business account id
  name        String // nome pagina o username IG
  accessToken String // page access token: per le Pagine Facebook di norma non scade finche' non revocato
  createdAt   DateTime     @default(now())
  posts       SocialPost[]

  @@unique([userId, provider, externalId])
}

/**
 * Post programmato su un SocialAccount. Non esposto ai tool dell'assistente
 * AI: pubblicare su un profilo pubblico e' un'azione difficile da annullare,
 * deve sempre passare da un'azione esplicita in dashboard.
 */
model SocialPost {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  user            User          @relation(fields: [userId], references: [id])
  userId          String        @db.ObjectId
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  socialAccountId String        @db.ObjectId
  content         String
  mediaPath       String? // path locale dell'immagine allegata (uploads/), se presente
  scheduledAt     DateTime
  status          String        @default("pending") // "pending" | "published" | "failed" | "canceled"
  externalPostId  String?
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
}

/**
 * Conversazione con l'assistente. Personale: nella chat puo' finire
 * qualsiasi cosa, anche argomenti che altrove restano privati (diario,
 * investimenti), quindi condividerla col team vanificherebbe quei confini.
 * Le azioni che l'assistente esegue restano invece condivise.
 * Separata per canale: le chat del web e quelle del bot non si mescolano.
 */
model Conversation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @db.ObjectId
  channel       String // "web" | "telegram"
  title         String
  createdAt     DateTime @default(now())
  // Aggiornato a ogni messaggio: serve a ordinare la lista per attivita'
  // recente senza dover interrogare i messaggi.
  lastMessageAt DateTime @default(now())
  // Su Telegram non c'e' modo di scegliere quale thread riprendere: la
  // conversazione attiva del canale e' quella con archived = false.
  archived      Boolean  @default(false)

  messages ConversationMessage[]

  @@index([userId, channel, archived])
}

model ConversationMessage {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String       @db.ObjectId
  role           String // "user" | "assistant"
  content        String
  // Nomi dei tool eseguiti in questo turno, per rimostrare i badge 🔧 quando
  // si riapre una conversazione salvata.
  toolNames      String[]
  // Path della foto allegata (bot Telegram): l'immagine non viene reinviata al
  // modello quando si ricarica lo storico, ma resta tracciata.
  photoPath      String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/**
 * Diario personale: mai condiviso col team, nemmeno tramite l'assistente.
 */
model DiaryEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  content   String
  mood      String? // es. "😊", "😔", "😐" — libero, non un enum chiuso
  createdAt DateTime @default(now())
}

/**
 * Collegamento OAuth2 a un account Google personale (Calendar + Gmail in
 * sola lettura). Solo la connessione/i token: la lettura effettiva di
 * calendario/email non e' ancora implementata, e' predisposta per dopo.
 */
model GoogleAccount {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @unique @db.ObjectId
  email                String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  scopes               String
  createdAt            DateTime @default(now())
}

/**
 * Portafoglio di investimenti personale (non condiviso col team): a
 * differenza di pasti/obiettivi/allenamenti, i dati finanziari restano
 * privati di chi li inserisce.
 */
model Holding {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  symbol    String // es. "AAPL", "VWCE.DE"
  quantity  Float
  costBasis Float? // prezzo medio di acquisto per azione/quota, per calcolare la plusvalenza
  createdAt DateTime @default(now())
}

model Meal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  team        Team     @relation(fields: [teamId], references: [id])
  teamId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  description String
  grams       Float?
  photoPath   String?
  calories    Float?
  loggedAt    DateTime @default(now())
  // true per i pasti generati da un piano alimentare AI (ancora da consumare),
  // false per i pasti effettivamente registrati come mangiati.
  planned     Boolean  @default(false)
  // Scheda alimentare e giorno della rotazione da cui questo pasto e' stato
  // materializzato (o che stava seguendo). Stessa scelta di WorkoutSession:
  // non e' una relation, il pasto sopravvive alla cancellazione della scheda.
  planId       String? @db.ObjectId
  planDayOrder Int?
}

model ShoppingListItem {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  team      Team      @relation(fields: [teamId], references: [id])
  teamId    String    @db.ObjectId
  name      String
  quantity  String?
  checked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  checkedAt DateTime?
}

model Device {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  team       Team    @relation(fields: [teamId], references: [id])
  teamId     String  @db.ObjectId
  name       String
  provider   String // "shelly" | "tahoma"
  externalId String
  deviceType String
  lastState  String?
}

model Goal {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  team        Team         @relation(fields: [teamId], references: [id])
  teamId      String       @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])
  userId      String       @db.ObjectId
  title       String
  description String?
  category    String       @default("general") // "general" | "gym"
  // "personal": visibile solo a chi l'ha creato. "team": visibile a tutto il team.
  scope       String       @default("team") // "personal" | "team"
  dueDate     DateTime?
  priority    String       @default("medium") // "low" | "medium" | "high"
  important   Boolean      @default(false)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  actions     GoalAction[]
}

model GoalAction {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  goal        Goal      @relation(fields: [goalId], references: [id])
  goalId      String    @db.ObjectId
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
}

model EmailAccount {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  user     User    @relation(fields: [userId], references: [id])
  userId   String  @db.ObjectId
  provider String
  address  String
  authRef  String?
}

model CalendarEvent {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  team           Team      @relation(fields: [teamId], references: [id])
  teamId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id])
  userId         String    @db.ObjectId
  provider       String
  externalId     String
  title          String
  startsAt       DateTime
  important      Boolean   @default(false)
  reminderSentAt DateTime?
}

model WorkoutSession {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  team      Team              @relation(fields: [teamId], references: [id])
  teamId    String            @db.ObjectId
  user      User              @relation(fields: [userId], references: [id])
  userId    String            @db.ObjectId
  loggedAt  DateTime          @default(now())
  exercises WorkoutExercise[]
  // Scheda e giorno della rotazione a cui questa sessione si riferisce, se
  // l'utente si stava allenando seguendo una scheda. Non e' una relation:
  // la sessione resta valida (e leggibile dal team) anche se la scheda,
  // che e' personale, viene cancellata. Sono anche l'unico stato da cui si
  // ricava a che punto della rotazione si e' arrivati: il "giorno di oggi"
  // e' quello dopo l'ultimo registrato, senza contatori da tenere allineati.
  planId        String?       @db.ObjectId
  planDayOrder  Int?

  @@index([userId, planId, loggedAt])
}

type WorkoutExercise {
  name     String
  sets     Int?
  reps     Int?
  weightKg Float?
  notes    String?
}

/**
 * Scheda di allenamento personale: il programma da seguire, distinto dalle
 * WorkoutSession che registrano cosa e' stato davvero fatto.
 *
 * Personale e non condivisa col team (come diario e investimenti): una scheda
 * dice cosa uno non riesce ancora a sollevare, e non e' un dato che ha senso
 * mettere in bacheca. Restano condivise le sessioni registrate.
 *
 * Validita': una sola scheda attiva per volta, quindi le finestre
 * [validFrom, validTo] di uno stesso utente non si sovrappongono mai —
 * vincolo applicato nel modulo, MongoDB non puo' esprimerlo. validTo null
 * significa "aperta, fino a nuovo ordine": creando una scheda successiva la
 * precedente viene chiusa al giorno prima del nuovo validFrom.
 */
model TrainingPlan {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @db.ObjectId
  name      String // es. "Massa 4 giorni", "Ricomposizione autunno"
  notes     String?
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())

  // Giorni della rotazione, ordinati per `order` (1..N). Non sono agganciati
  // ai giorni della settimana: si esegue il giorno successivo a quello fatto
  // l'ultima volta, quando si va in palestra.
  days TrainingPlanDay[]

  @@index([userId, validFrom])
}

/**
 * Un giorno della rotazione. Composite type e non modello a se': i giorni non
 * si citano da fuori (chi ci si riferisce usa planId + order, che non cambiano
 * se la scheda viene riordinata) e cosi' l'intera scheda si legge e si
 * riscrive come un documento solo.
 */
type TrainingPlanDay {
  // Posizione nella rotazione, 1-based. Unico dentro la scheda: garantito dal
  // modulo, un composite type non puo' avere @@unique.
  order     Int
  name      String // es. "Petto e tricipiti"
  notes     String?
  exercises TrainingPlanExercise[]
}

type TrainingPlanExercise {
  name String
  sets Int?
  // Stringa e non Int: una scheda prescrive spesso un intervallo ("8-10") o
  // un modo di finire la serie ("cedimento"), non un numero secco. Il numero
  // secco resta in WorkoutExercise.reps, che registra cosa si e' fatto.
  reps        String?
  weightKg    Float?
  restSeconds Int?
  notes       String?
}

/**
 * Scheda alimentare personale. Stessa forma della scheda di allenamento:
 * finestra di validita' senza sovrapposizioni e giorni ordinati in rotazione
 * (non lunedi'-domenica), cosi' le due si spiegano e si gestiscono allo
 * stesso modo.
 *
 * Distinta dai Meal con planned=true, che restano i pasti di una singola
 * giornata: la scheda e' il modello ricorrente da cui quei pasti si generano.
 */
model NutritionPlan {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @db.ObjectId
  name      String // es. "Definizione 1800 kcal"
  notes     String?
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())

  days NutritionPlanDay[]

  @@index([userId, validFrom])
}

type NutritionPlanDay {
  order Int
  name  String // es. "Giorno di allenamento", "Giorno di scarico"
  notes String?
  meals NutritionPlanMeal[]
}

type NutritionPlanMeal {
  // "colazione" | "spuntino" | "pranzo" | "merenda" | "cena" — stringa libera
  // come gli altri enum di questo schema, i pasti della giornata cambiano
  // troppo da persona a persona per chiuderli.
  slot        String
  description String
  grams       Float?
  calories    Float?
}
