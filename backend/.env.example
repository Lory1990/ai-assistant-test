DATABASE_URL="mongodb://localhost:27017/assistant?replicaSet=rs0"
REDIS_URL="redis://localhost:6379"

# Keycloak (login web email/password/social — realm "personal-assistant" auto-importato,
# vedi keycloak/realm-export.json). Per abilitare login social (Google/GitHub/...) va
# aggiunto un Identity Provider dalla console admin di Keycloak con le tue credenziali
# OAuth: non è qualcosa che si possa precompilare qui.
KEYCLOAK_ISSUER_URL="http://localhost:8081/realms/personal-assistant"
# Se il backend gira in un container Docker separato da Keycloak, deve raggiungerlo
# tramite l'hostname interno (es. http://keycloak:8080/...) per scaricare le chiavi
# JWKS, anche se l'issuer nei token resta quello pubblico sopra. In esecuzione locale
# senza Docker puoi lasciarla vuota (usera' lo stesso KEYCLOAK_ISSUER_URL).
KEYCLOAK_INTERNAL_URL=
# Client confidenziale che il backend usa per il login email/password (direct
# grant), lo scambio del code dopo il redirect social e l'Admin API
# (registrazione utenti, invio email di reset password). La schermata di login
# sta nella nostra app: il browser non parla mai direttamente con Keycloak.
# Il valore sotto e' il secret di sviluppo presente in keycloak/realm-export.json
# — rigeneralo (Keycloak > Clients > backend-service > Credentials) per un uso reale.
KEYCLOAK_BACKEND_CLIENT_ID=backend-service
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-only-backend-secret-change-me
KEYCLOAK_SOCIAL_REDIRECT_URI=http://localhost:3000/api/auth/social/callback

# Telegram
TELEGRAM_BOT_TOKEN=

# Shelly Cloud API
SHELLY_CLOUD_SERVER=
SHELLY_CLOUD_AUTH_KEY=

# Somfy TaHoma / Overkiz Cloud API
OVERKIZ_SERVER=https://ha101-1.overkiz.com/enduser-mobile-web/enduserAPI
OVERKIZ_USERNAME=
OVERKIZ_PASSWORD=

# Calorie lookup (e.g. Nutritionix, Edamam)
CALORIE_API_APP_ID=
CALORIE_API_APP_KEY=

# Google (Calendar + Gmail, sola lettura) — crea credenziali OAuth2 "Web application"
# su https://console.cloud.google.com/apis/credentials, con questo esatto redirect URI
# registrato (deve combaciare byte per byte con GOOGLE_REDIRECT_URI qui sotto).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Dove reindirizzare il browser dopo il collegamento Google (la dashboard web).
FRONTEND_URL=http://localhost:8080

# Outlook / Microsoft Graph (OAuth2)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=

# Apple Music (MusicKit)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=

# Alexa (vedi TODO in src/modules/music/alexaCastProvider.ts per le opzioni reali)
ALEXA_REFRESH_TOKEN=
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=

# TV Hisense (VIDAA) — protocollo locale, vedi TODO in src/modules/tv/client.ts
HISENSE_TV_IP=
HISENSE_TV_MAC=
HISENSE_TV_MQTT_PORT=36669

# Anthropic diretto (fallback se non usi Azure AI Foundry, vedi sotto)
ANTHROPIC_API_KEY=

# Modelli Claude su Azure AI Foundry (usato per il piano alimentare AI in
# src/modules/mealPlan) — se valorizzato ha priorità su ANTHROPIC_API_KEY.
# Endpoint e nome del deployment si trovano nel portale Azure AI Foundry
# della tua risorsa.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=claude-sonnet-5

# Alpha Vantage (prezzi azioni/ETF per la sezione Investimenti) — chiave
# gratuita su https://www.alphavantage.co/support/#api-key. Tier free molto
# limitato (poche richieste/giorno): i prezzi sono cachati 15 minuti.
ALPHA_VANTAGE_API_KEY=

# OpenAI (usato SOLO per trascrivere i messaggi vocali Telegram con Whisper,
# non collegato al provider AI principale)
OPENAI_API_KEY=

# App Meta (Facebook Login) per la sezione Social — copre sia le Pagine
# Facebook che gli account Instagram Business collegati. Crea l'app su
# https://developers.facebook.com/apps e registra il redirect URI qui sotto.
# NOTA: in modalità sviluppo i permessi pages_manage_posts /
# instagram_content_publish funzionano solo sul tuo account Meta; per usarli
# con altri utenti serve la App Review di Meta.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# URL pubblico (raggiungibile da internet) sotto cui il backend serve /uploads.
# Obbligatorio per pubblicare immagini: i server di Instagram/Facebook scaricano
# la foto da questo URL. Su localhost lascialo vuoto — restano possibili solo i
# post di solo testo su Facebook.
PUBLIC_BASE_URL=
